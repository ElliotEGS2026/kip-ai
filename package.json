{
  "name": "kip-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kip - personal morning briefing app (local only)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "generate": "tsx src/generator/cli.ts",
    "serve": "tsx src/server/index.ts",
    "start": "npm run build && npm run serve"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
