# Copy to .env (gitignored). Every value is optional.
KIP_PORT=47821
# Calendar via ICS feed (Outlook: Settings > Calendar > Shared calendars > publish > ICS link)
KIP_ICS_URL=
# Microsoft connection: Entra app registration "Application (client) ID" (see README)
KIP_MS_CLIENT_ID=
# "common" (work + personal), "organizations" (work only) or your tenant id
KIP_MS_TENANT=common
